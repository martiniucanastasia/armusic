# From https://launchpad.37signals.com/integrations (register an app)
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:4567/callback

# Printed by `npm run auth` after you authorize (the account whose product is "bcx" = Basecamp 2)
BASECAMP_ACCOUNT_ID=

# Basecamp asks for app name + contact email
BASECAMP_USER_AGENT=armusic.mx calendar sync (you@example.com)

# How far back / ahead to publish events
PAST_DAYS=30
FUTURE_DAYS=365 # only used if END_DATE is empty
END_DATE=2040-12-31

# What the public site is allowed to see
INCLUDE_DESCRIPTION=true
INCLUDE_ASSIGNED=true

# Where the public JSON is written, and where tokens are stored
OUTPUT_FILE=out/calendar.json
TOKEN_FILE=.tokens.json
