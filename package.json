{
  "name": "armusic-basecamp-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "auth": "tsx --env-file=.env src/auth.ts",
    "sync": "tsx --env-file=.env src/sync.ts",
    "sync:ci": "tsx src/sync.ts",
    "site": "python3 -m http.server 8080 --directory site",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
